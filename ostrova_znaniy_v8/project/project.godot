; Engine configuration file.
config_version=5

[application]

config/name="Острова Знаний"
config/description="Обучающая игра для 2–4 классов"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.105, 0.149, 0.302, 1)
boot_splash/show_image=false
run/low_processor_mode=false

[autoload]

Settings="*res://scripts/core/settings.gd"
Content="*res://scripts/core/content_db.gd"
Profiles="*res://scripts/core/profiles.gd"
Audio="*res://scripts/core/audio_manager.gd"
Wellbeing="*res://scripts/core/wellbeing.gd"
Router="*res://scripts/core/router.gd"
TouchScroll="*res://scripts/core/touch_scroll.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/android/enable_pan_and_scale_gestures=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.105, 0.149, 0.302, 1)
