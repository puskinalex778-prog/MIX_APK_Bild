static func fill(line: String) -> String:
	var p: Dictionary = Profiles.current()
	var girl: bool = p.get("gender", "boy") == "girl"
	return line.replace("{name}", str(p.get("name", "друг"))).replace("{a}", "а" if girl else "") \
		.replace("{hero}", "настоящая героиня" if girl else "настоящий герой") \
		.replace("{stronger}", "становишься сильнее и умнее")


static func lines_before(step: int, topic_id: String, grade: int) -> Array:
	var out = []
	if step == 0:
		out.append_array(INTRO.get(grade, INTRO[2]))
	for m in MILESTONES:
		if m[0] == step:
			out.append_array(m[1])
	var subj: String = Content.topic_info(topic_id).get("subject", "math")
	var pool: Array = SUBJECT_LINES[subj]
	out.append(pool[step % pool.size()])
	out.append([subj, "Тема: «%s». Готов{a}?" % Content.topic_info(topic_id).get("title", "")])
	return out
